# Leave both values blank to create the first administrator in the web UI.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional. When blank, QuickLinks generates and persists a secret in DATA_DIR.
SESSION_SECRET=
PORT=6969

# Set to 1 behind a reverse proxy so login throttling sees real client
# addresses from X-Forwarded-For instead of the proxy's own.
TRUST_PROXY=

# auto adds the Secure cookie flag when X-Forwarded-Proto is https.
# Use 1 to force it on, 0 to force it off.
SESSION_COOKIE_SECURE=auto
